---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroStage from '../components/HeroStage.tsx';
import PixelLab from '../components/PixelLab.tsx';
import CodeWalkthrough from '../components/CodeWalkthrough.tsx';
import { faq } from '../data/faq';
import { site } from '../data/site';
import chromeHero from '../assets/shots/chrome-hero.png';
import pptrDocs from '../assets/shots/pptr-docs.png';
import pptrCode from '../assets/shots/pptr-code.png';
import pptrMobileTop from '../assets/shots/pptr-mobile-top.png';
import pptrMobile from '../assets/shots/pptr-mobile.png';

const steps = [
  { tone: 'light', clause: '先启动一个浏览器。', note: 'puppeteer.launch()' },
  { tone: 'mid', clause: '再开一个空白页。', note: 'browser.newPage()' },
  { tone: 'deep', clause: '像用户一样操作它。', note: 'page.goto() · locator()' },
  { tone: 'dark', clause: '最后关掉它。', note: 'browser.close()' },
];

const features = [
  {
    title: '页面是什么样，截出来就是什么样',
    body: 'page.screenshot() 交回一个 Buffer，page.pdf() 直接给你一份可打印的文档。整页、可视区、单个元素，位置和尺寸都由你指定。',
    image: chromeHero,
    alt: '用 Puppeteer 截取的 developer.chrome.com 首屏局部，大标题为 “A Powerful Web. Made Easier.”',
  },
  {
    title: '单页应用，一次也不落空',
    body: 'Puppeteer 把“任何改变 URL 的行为”都算作导航，包括锚点跳转与 History API。等页面稳定再返回，是默认行为。',
    image: pptrDocs,
    alt: '用 Puppeteer 截取的 pptr.dev 文档页局部，标题为 “What is Puppeteer?”。',
  },
  {
    title: '换一个尺寸，就是另一台设备',
    body: '一次 setViewport 调用，页面立刻按 390 × 844 重排。移动端布局的回归测试不必依赖真机，也不必手动拖窗口。',
    image: pptrMobileTop,
    alt: '用 Puppeteer 以 390 像素宽视口截取的 pptr.dev 页面顶部，导航与标题按移动端布局重排。',
  },
  {
    title: '装完之后，浏览器自己会下来',
    body: '安装时自动下载 Chrome for Testing 与 chrome-headless-shell，版本与库锁定。如果包管理器拦了安装脚本，跑一次 npx puppeteer browsers install。',
    image: pptrCode,
    alt: '用 Puppeteer 截取的 pptr.dev 安装页局部，含安装命令与“自动下载可能被阻止”的警告。',
  },
];

const facts = [
  { term: '当前版本', detail: `v${site.version}` },
  { term: '底层协议', detail: 'DevTools Protocol / WebDriver BiDi' },
  { term: '可驱动', detail: 'Chrome · Firefox' },
  { term: '两个包', detail: 'puppeteer · puppeteer-core' },
  { term: '默认模式', detail: '无头，可切换有头' },
];
---

<Base title="Puppeteer 中文文档" description={site.description} tone="dark">
  <!-- 1. hero -->
  <section class="hero">
    <div class="shell">
      <HeroStage client:load />

      <div class="mt-[clamp(24px,3.4vh,38px)] flex flex-col items-center gap-6 text-center">
        <p class="max-w-[48ch] text-[16px] leading-relaxed text-white/70 md:text-[18px]">
          Puppeteer 是一个 JavaScript 库，用一套高级 API 通过 DevTools Protocol 或 WebDriver BiDi
          控制 Chrome 与 Firefox。默认无头运行，也可以带着窗口出现。
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
          <a class="btn" href="/docs/installation">开始安装</a>
          <a class="link-underline text-[16px] text-white/80" href="/docs/what-is-puppeteer">
            先看它是什么
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. intro：左文右表，铺满一行 -->
  <section class="sec">
    <div class="shell grid gap-x-10 gap-y-12 md:grid-cols-12">
      <div class="intro-copy md:col-span-7">
        <p class="intro-lead reveal">Puppeteer 把一个真实的浏览器交到你手里。</p>
        <div class="mt-7 space-y-7">
          <p class="reveal" style="--reveal-delay:60ms">
            几行代码就能让它打开页面、按下按键、读出任何一个元素。它运行在 Node.js 上，默认无头——没有窗口，也不需要显示器。
          </p>
          <p class="reveal" style="--reveal-delay:100ms">
            你可以把它放进 CI，也可以放进一台没有图形界面的服务器。
          </p>
          <p class="reveal" style="--reveal-delay:150ms">
            底层是 Chrome DevTools Protocol，或者 WebDriver BiDi。同一套 API 既能驱动 Chrome，也能驱动 Firefox。
          </p>
          <p class="reveal" style="--reveal-delay:200ms">
            这个站按官方 Introduction 分类逐篇翻译，API 名称与代码保留英文原文。
          </p>
          <p class="reveal" style="--reveal-delay:250ms">
            想直接动手，去<a class="link-underline" href="/docs/installation">安装</a>；想先弄清楚它在做什么，继续往下读。
          </p>
        </div>
      </div>

      <dl class="factlist md:col-span-4 md:col-start-9">
        {
          facts.map((fact, index) => (
            <div class="fact reveal" style={`--reveal-delay:${index * 50}ms`}>
              <dt>{fact.term}</dt>
              <dd>{fact.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 3. features：2 × 2 -->
  <section class="sec bg-surface">
    <div class="shell">
      <div class="grid gap-x-10 gap-y-5 md:grid-cols-12 md:items-end">
        <h2
          class="reveal text-[26px] font-medium leading-[1.12] tracking-[-0.025em] text-ink md:col-span-7 md:text-[32px]"
        >
          它每天被用来做的四件事
        </h2>
        <p class="max-w-[36ch] text-[16px] leading-[1.6] text-ink-soft md:col-span-4 md:col-start-9">
          下面四张图不是配图，是用 Puppeteer 真的跑出来、再截下来的。
        </p>
      </div>

      <div class="mt-10 grid gap-x-8 gap-y-12 md:mt-12 md:grid-cols-2">
        {
          features.map((feature, index) => (
            <article class="reveal" style={`--reveal-delay:${index * 60}ms`}>
              <div class="feature-panel">
                <Image
                  src={feature.image}
                  alt={feature.alt}
                  widths={[640, 1280]}
                  sizes="(max-width: 767px) 100vw, 50vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  class="h-full w-full object-cover object-top"
                />
              </div>
              <h3 class="mt-5 text-[21px] font-medium leading-[1.28] tracking-[-0.01em]">
                {feature.title}
              </h3>
              <p class="mt-2 max-w-[46ch] text-[16px] leading-[1.6] text-ink-soft">
                {feature.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. how-it-works -->
  <section class="how-strip" aria-labelledby="how-title">
    {
      steps.map((step, index) => (
        <div class:list={['how-field', `how-field--${step.tone}`]}>
          {index === 0 && (
            <h2 id="how-title" class="how-heading">
              一次自动化
              <br />
              从头到尾
            </h2>
          )}
          <div class="how-card">
            <div class="how-card__bar">
              <span class="how-card__url">
                {index === 0
                  ? 'about:blank'
                  : index === 1
                    ? 'developer.chrome.com'
                    : index === 2
                      ? 'devsite-search'
                      : 'browser.close()'}
              </span>
            </div>
            <div class="how-card__body">
              {index === 0 && <span class="how-blank">空白页</span>}
              {index === 1 && (
                <div class="how-page">
                  <span class="how-page__title">Chrome for developers</span>
                  <span class="how-page__line" />
                  <span class="how-page__line how-page__line--short" />
                </div>
              )}
              {index === 2 && (
                <div class="how-page">
                  <span class="how-search">automate beyond recorder</span>
                  <span class="how-result">Customize and automate</span>
                  <span class="how-result how-result--dim">Chrome DevTools 指南</span>
                </div>
              )}
              {index === 3 && <span class="how-blank how-blank--closed">已断开</span>}
            </div>
          </div>
          <p class="how-clause">{step.clause}</p>
          <p class="how-note">{step.note}</p>
        </div>
      ))
    }
  </section>

  <!-- 5. showcase -->
  <section class="sec">
    <div class="shell">
      <CodeWalkthrough client:visible />
    </div>
  </section>

  <!-- 6. stats -->
  <PixelLab client:visible />

  <!-- 7. faq -->
  <section class="sec" aria-labelledby="faq-title">
    <div class="shell grid gap-x-10 gap-y-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <div class="md:sticky md:top-10">
          <h2
            id="faq-title"
            class="reveal text-[clamp(2rem,1.4rem+2.4vw,2.75rem)] font-medium leading-[1.02] tracking-[-0.03em] text-ink"
          >
            常见
            <br />
            问题
          </h2>
          <p class="mt-6 max-w-[34ch] text-[16px] leading-[1.65] text-ink-soft">
            关于协议、版本、维护团队和求助渠道，先看这里。
          </p>
          <a href="/faq" class="link-underline mt-5 inline-block text-[16px] font-medium">
            全部 {faq.length} 个问题
          </a>
        </div>
      </div>
      <div class="md:col-span-8">
        {
          faq.slice(0, 6).map((item, index) => (
            <details
              id={item.id}
              class="faq-tile reveal"
              name="faq"
              style={`--reveal-delay:${index * 40}ms`}
            >
              <summary>
                <span>{item.question}</span>
                <span class="faq-plus" aria-hidden="true" />
              </summary>
              <div class="faq-answer" set:html={item.answer} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 8. cta -->
  <section class="cta-wrap" aria-labelledby="cta-title">
    <div class="cta-row">
      <div class="cta-side cta-side--photo">
        <Image
          src={pptrMobile}
          alt="用 Puppeteer 以 390 像素宽视口截取的 pptr.dev 文档页"
          widths={[240, 480]}
          sizes="(max-width: 900px) 50vw, 16vw"
          loading="lazy"
          class="h-full w-full object-cover object-top"
        />
      </div>
      <div class="cta-main">
        <h2 id="cta-title" class="cta-title">把手动点的那几下交出去</h2>
        <p class="cta-body">装完之后，你会先写三行代码。然后你会发现，剩下的都可以交给它了。</p>
        <a class="btn btn--ink" href="/docs/installation">安装 Puppeteer</a>
      </div>
      <div class="cta-side cta-side--flat" aria-hidden="true"></div>
    </div>
  </section>
</Base>

<style>
  .sec {
    padding-block: clamp(64px, 6vw, 96px);
  }

  .intro-lead {
    font-size: clamp(20px, 1.4vw + 13px, 26px);
    line-height: 1.32;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--color-ink);
    max-width: 20em;
    text-wrap: balance;
  }

  .intro-copy p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }

  .intro-copy {
    font-size: 16px;
    max-width: 36em;
  }

  /* fact list */
  .factlist {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fact {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding-block: 14px;
  }

  .fact dt {
    flex: 0 0 5.2em;
    font-size: 13px;
    color: var(--color-muted);
  }

  .fact dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* features */
  .feature-panel {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-field-2);
  }

  /* how strip */
  .how-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    min-height: 62svh;
  }

  .how-field {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 26px 24px 30px;
    min-height: 62svh;
  }

  .how-field--light {
    background: #e3e1dc;
    color: var(--color-ink);
  }
  .how-field--mid {
    background: #aab3c4;
    color: var(--color-field-1);
  }
  .how-field--deep {
    background: #4a5878;
    color: #fff;
  }
  .how-field--dark {
    background: var(--color-field-1);
    color: #fff;
  }

  .how-heading {
    font-size: clamp(17px, 1.3vw, 20px);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  .how-card {
    position: absolute;
    top: 26%;
    left: 50%;
    width: 272px;
    min-height: 152px;
    translate: -50% 0;
    background: #fff;
    color: var(--color-ink);
    transition: translate 180ms var(--ease-out);
  }

  .how-field:hover .how-card {
    translate: -50% -6px;
  }

  .how-card__bar {
    padding: 8px 10px;
    background: #eef0f4;
    font-family: var(--font-display);
    font-size: 13px;
    color: #5c6478;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .how-card__body {
    padding: 16px 12px 22px;
    min-height: 112px;
  }

  .how-blank {
    display: block;
    font-size: 13px;
    color: #8b94a6;
  }

  .how-blank--closed {
    color: #c2452f;
  }

  .how-page {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .how-page__title {
    font-size: 13px;
    font-weight: 600;
  }

  .how-page__line {
    display: block;
    height: 5px;
    width: 86%;
    background: #e3e6ed;
  }

  .how-page__line--short {
    width: 54%;
  }

  .how-search {
    display: block;
    padding: 5px 7px;
    background: #f2f3f6;
    font-size: 13px;
    color: #4b5365;
  }

  .how-result {
    display: block;
    font-size: 13px;
    color: var(--color-ink);
  }

  .how-result--dim {
    color: var(--color-muted);
  }

  .how-clause {
    margin-top: auto;
    padding-top: 24px;
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.22;
    letter-spacing: -0.02em;
    font-weight: 500;
    max-width: 9em;
  }

  .how-note {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 13px;
    opacity: 0.62;
  }

  @media (max-width: 900px) {
    .how-strip {
      grid-template-columns: 1fr;
    }
    .how-field {
      min-height: 56svh;
    }
    .how-card {
      position: static;
      width: 100%;
      max-width: 320px;
      translate: none;
      margin: 40px 0 0;
    }
    .how-field:hover .how-card {
      translate: none;
    }
    .how-clause {
      margin-top: 36px;
      padding-top: 0;
    }
  }

  /* cta */
  .cta-wrap {
    padding-inline: 12px;
    padding-bottom: clamp(56px, 7vw, 88px);
  }

  .cta-row {
    display: grid;
    grid-template-columns: 16vw 1fr 16vw;
    gap: 12px;
  }

  .cta-side {
    height: 340px;
    overflow: hidden;
  }

  .cta-side--flat {
    background: var(--color-field-2);
  }

  .cta-main {
    height: 340px;
    background: var(--color-accent);
    color: var(--color-ink);
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
  }

  .cta-title {
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 500;
    max-width: 14ch;
  }

  .cta-body {
    font-size: 16px;
    line-height: 1.5;
    max-width: 34ch;
  }

  @media (max-width: 900px) {
    .cta-row {
      grid-template-columns: 1fr 1fr;
    }
    .cta-main {
      grid-column: 1 / -1;
      grid-row: 1;
      height: auto;
      min-height: 300px;
      padding: 32px 24px;
    }
    .cta-side {
      height: 150px;
      grid-row: 2;
    }
  }

  @media (max-width: 767px) {
    .fact dt {
      flex-basis: 4.6em;
    }
  }
</style>

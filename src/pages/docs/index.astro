---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import { docCategories } from '../../data/docCategories';

const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const groups = docCategories
  .map((category) => ({
    ...category,
    items: entries.filter((entry) => entry.data.category === category.key),
  }))
  .filter((group) => group.items.length > 0);
---

<Base title="文档" description="Puppeteer 中文文档：入门、核心概念、指南、集成与社区，对应官方 v25.18.1 全部文档分类。">
  <div class="shell pt-12 pb-[clamp(72px,9vw,140px)] md:pt-20">
    <header class="reveal grid gap-8 md:grid-cols-12 md:items-end">
      <h1
        class="text-[clamp(2.8rem,1.4rem+6vw,7rem)] font-medium leading-[0.9] tracking-[-0.04em] md:col-span-7"
      >
        文档
      </h1>
      <p class="max-w-[40ch] text-[16px] leading-[1.6] text-muted md:col-span-5">
        对应官方文档的全部分类：入门、核心概念、指南、示例、集成、社区与参考，共 {entries.length} 篇。
      </p>
    </header>

    <div class="mt-[clamp(48px,7vw,96px)] flex flex-col gap-[clamp(48px,6vw,88px)]">
      {
        groups.map((group) => (
          <section aria-label={group.label}>
            <div class="reveal flex flex-wrap items-baseline gap-x-6 gap-y-2 border-b border-field-2 pb-5">
              <h2 class="text-[clamp(1.7rem,1.3rem+1.8vw,2.6rem)] font-medium tracking-[-0.02em]">
                {group.label}
              </h2>
              <p class="text-[15px] leading-[1.6] text-muted">{group.blurb}</p>
            </div>
            <div class="mt-2">
              {group.items.map((entry, index) => (
                <a href={`/docs/${entry.id}`} class="doc-index-row">
                  <h3 class="doc-index-title reveal" style={`--reveal-delay:${index * 50}ms`}>
                    {entry.data.title}
                  </h3>
                  <p class="doc-index-desc reveal" style={`--reveal-delay:${index * 50 + 30}ms`}>
                    {entry.data.description}
                  </p>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div class="reveal mt-[clamp(56px,8vw,110px)] grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <h2 class="text-[19px] font-medium tracking-[-0.01em]">还不够？</h2>
      </div>
      <div class="md:col-span-8">
        <p class="max-w-[52ch] text-[16px] leading-[1.7] text-ink">
          文档正文已全部译出。API 参考与更新日志体量庞大且随版本自动生成，请直接查阅官方站。
        </p>
        <div class="mt-7 flex flex-wrap gap-x-10 gap-y-3">
          <a href="/faq" class="link-underline text-[15px] font-medium">常见问题</a>
          <a href={site.links.api} target="_blank" rel="noreferrer" class="link-underline text-[15px] font-medium">
            API 参考
          </a>
          <a href={site.links.examples} target="_blank" rel="noreferrer" class="link-underline text-[15px] font-medium">
            官方示例
          </a>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .doc-index-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px;
    align-items: center;
    padding: 30px 20px 30px 0;
    transition:
      background-color 200ms var(--ease-out),
      padding 200ms var(--ease-out);
  }

  .doc-index-row:hover {
    background: var(--color-surface);
    padding-left: 20px;
  }

  .doc-index-title {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .doc-index-desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  @media (max-width: 767px) {
    .doc-index-row {
      grid-template-columns: 1fr;
      row-gap: 10px;
      padding: 24px 0;
    }
    .doc-index-desc {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>

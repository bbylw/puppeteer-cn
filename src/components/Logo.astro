---
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className = '' } = Astro.props;
---

<svg
  class:list={['logo-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M6.6 2.6 17.4 10.2M17.4 2.6 6.6 10.2"
    stroke="currentColor"
    stroke-width="2.6"
    stroke-linecap="square"
  />
  <rect x="3.6" y="11.6" width="16.8" height="9.8" stroke="currentColor" stroke-width="1.7" />
</svg>

<style>
  .logo-mark {
    color: var(--color-ink);
    flex: 0 0 auto;
  }

  :global(.site-header[data-tone='dark']) .logo-mark {
    color: var(--color-accent);
  }
</style>

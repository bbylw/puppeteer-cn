---
import { nav, site } from '../data/site';
import SearchDialog from './SearchDialog.tsx';
import Logo from './Logo.astro';

interface Props {
  tone?: 'light' | 'dark';
  searchItems?: { title: string; href: string; kind: string; text: string }[];
}

const { tone = 'light', searchItems = [] } = Astro.props;
const dark = tone === 'dark';
const current = Astro.url.pathname;
---

<header
  class:list={[
    'site-header relative z-40',
    dark ? 'bg-field-1 text-white' : 'bg-bg text-ink',
  ]}
  data-tone={tone}
>
  <div class="shell flex h-[68px] items-center gap-4 md:h-[76px]">
    <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label="Puppeteer 首页">
      <Logo size={24} />
      <span class="wordmark text-[19px] font-medium tracking-[-0.03em] md:text-[21px]">
        Puppeteer
      </span>
    </a>

    <nav class="ml-auto hidden items-center gap-7 md:flex" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'u-small link-plain',
              current === item.href ? 'is-current' : '',
              dark ? 'text-white/80 hover:text-white' : 'text-ink/75 hover:text-ink',
            ]}
            aria-current={current === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.links.github}
        target="_blank"
        rel="noreferrer"
        class:list={[
          'u-small link-plain',
          dark ? 'text-white/80 hover:text-white' : 'text-ink/75 hover:text-ink',
        ]}
      >
        GitHub
      </a>
    </nav>

    <div class="ml-auto flex items-center gap-3 md:ml-0">
      <SearchDialog client:load items={searchItems} />

      <details class="mobile-menu md:hidden">
        <summary
          class:list={[
            'u-small flex h-9 cursor-pointer list-none items-center px-3 [&::-webkit-details-marker]:hidden',
            dark ? 'bg-white/10 text-white' : 'bg-surface text-ink',
          ]}
        >
          菜单
        </summary>
        <nav
          class:list={[
            'absolute left-2 right-2 top-[64px] z-50 flex flex-col p-2',
            dark ? 'bg-[#111620] text-white' : 'bg-surface text-ink',
          ]}
          aria-label="移动导航"
        >
          {
            nav.map((item) => (
              <a href={item.href} class="u-small px-4 py-3">
                {item.label}
              </a>
            ))
          }
          <a href={site.links.github} target="_blank" rel="noreferrer" class="u-small px-4 py-3">
            GitHub
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .link-plain {
    position: relative;
    transition: color 160ms ease;
  }
  .link-plain.is-current {
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
  }
  .mobile-menu[open] summary {
    background: var(--color-accent);
    color: var(--color-ink);
  }
</style>
